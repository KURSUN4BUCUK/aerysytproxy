# ============================================================
# 1. Phusion Passenger Node.js Başlatma Ayarları
# ============================================================
PassengerEnabled on
PassengerAppRoot /home/aeryssi3/public_html
PassengerAppType node
PassengerStartupFile main.js
PassengerNodejs /home/aeryssi3/nodevenv/public_html/18/bin/node
PassengerAppEnv production

# ============================================================
# 2. Performans ve Havuz Ayarları
# ============================================================
PassengerMinInstances 1
PassengerMaxPoolSize 4
PassengerPoolIdleTime 300

# ============================================================
# 3. YÖNLENDİRME (REWRITE ENGINE) KURALLARI
# ============================================================
RewriteEngine On

# Eğer istek fiziksel bir dosyaya (css, js, logo, index.html) gidiyorsa direkt dosyayı ver, kodla yorma
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Sadece /api/ ile başlayan istekleri doğrudan Express (server.js) uygulamasına pasla
RewriteRule ^api/(.*)$ main.js/api/$1 [QSA,L]