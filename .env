# Database
DB_HOST=91.151.88.8
DB_USER=aeryssi3_root
DB_PASS=theloser88!
DB_NAME=aeryssi3_main

# JWT Secret
JWT_SECRET=supersecretkey123456

# Server
PORT=3000
MAX_CONCURRENT=3

# ==============================================
# CLOUDFLARE WORKER PROXY (ÖNERİLEN)
# ==============================================

# CloudFlare Worker Proxy URL (YouTube ban riski %0!)
# Yapısı: https://your-worker.workers.dev/?url=YOUTUBE_URL
CLOUDFLARE_WORKER_URL=https://yt-proxy.psoresmi.workers.dev

# CloudFlare Worker kullan (true = aktif, false = eski sistem)
USE_CLOUDFLARE_WORKER=true

# ==============================================
# PROXY AYARLARI (CloudFlare kapalıysa kullanılır)
# ==============================================

# SEÇENEK 1: Webshare (Önerilen - Rotating Proxy)
# https://www.webshare.io/ - Ücretsiz hesap 10 proxy veriyor
# Ücretli plan: $2.99/ay (1GB), daha stabil
WEBSHARE_API_KEY=

# SEÇENEK 2: Manuel Proxy Listesi (Virgülle ayır)
# PROXY_LIST=http://user:pass@proxy1.com:8080,http://user:pass@proxy2.com:8080,socks5://proxy3.com:1080

# SEÇENEK 3: Tek Sabit Proxy (En basit ama rotating yok)
# YOUTUBE_PROXY=http://username:password@proxy-server:port

# SEÇENEK 4: ÜCRETSİZ Proxy API'ler (Riskli ama parasız çözüm)
# ProxyScrape, GitHub proxy listeleri vb. Her 10 dakikada otomatik günceller
# ÖNEMLİ: Bu proxy'ler çok patlıyor, sürekli değişiyor, sadece test için!
USE_FREE_PROXIES=false

# NOT: Birden fazla seçenek varsa öncelik:
# 1. YOUTUBE_PROXY (varsa sadece bunu kullanır)
# 2. PROXY_LIST + WEBSHARE_API_KEY (hepsini birleştirip rotating yapar)
# 3. USE_FREE_PROXIES=true ise ücretsiz proxy'leri de ekler
# 4. Hiçbiri yoksa → Hosting IP (YouTube ban riski!)
